      "name": "PM-03 Login correcto (SWR-AUTH-002)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"Entrega un JWT de tres partes\", () => {",
              "  pm.expect(pm.response.json().accessToken.split(\".\")).to.have.lengthOf(3);",
              "});",
              "pm.test(\"Responde en menos de 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
              "pm.environment.set(\"token\", pm.response.json().accessToken);"
            ]
          }
        }
      ],
