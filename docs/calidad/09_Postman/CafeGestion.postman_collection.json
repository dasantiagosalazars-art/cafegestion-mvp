    {
      "name": "PM-06 Registrar lote válido (SWR-LOTE-001)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
              "const lote = pm.response.json();",
              "pm.test(\"El lote guarda nombre, área y cultivo\", () => {",
              "  pm.expect(lote.nombre).to.eql(\"El Mirador\");",
              "  pm.expect(Number(lote.areaHa)).to.eql(2.5);",
              "  pm.expect(lote.tipoCultivo).to.eql(\"Café\");",
              "});",
              "pm.test(\"El lote queda ligado a la finca del usuario\", () => pm.expect(lote.fincaId).to.be.a(\"string\"));",
              "pm.environment.set(\"loteId\", lote.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
