      "name": "PM-09 Registrar cosecha 100 kg (SWR-COS-001)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
              "const c = pm.response.json();",
              "pm.test(\"La cosecha nace en estado REGISTRADA\", () => pm.expect(c.estado).to.eql(\"REGISTRADA\"));",
              "pm.test(\"Guarda cantidad y producto\", () => {",
              "  pm.expect(Number(c.cantidadKg)).to.eql(100);",
              "  pm.expect(c.tipoProducto).to.eql(\"PERGAMINO_SECO\");",
              "});",
              "pm.environment.set(\"cosechaId\", c.id);"
            ]
          }
        }
