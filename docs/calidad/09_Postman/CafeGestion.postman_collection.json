  "item": [
    {
      "name": "PM-01 Registrar finca y usuario (SWR-AUTH-001)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const sufijo = Date.now();",
              "pm.environment.set(\"email\", \"postman_\" + sufijo + \"@prueba.com\");",
              "pm.environment.set(\"password\", \"Pw\" + sufijo + \"x\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
              "const cuerpo = pm.response.json();",
              "pm.test(\"Devuelve accessToken y usuario con rol PRODUCTOR\", () => {",
              "  pm.expect(cuerpo.accessToken).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(cuerpo.usuario.rol).to.eql(\"PRODUCTOR\");",
              "});",
              "pm.test(\"No expone la contraseña ni su hash (SWR-SEC-002)\", () => {",
              "  const texto = pm.response.text();",
              "  pm.expect(texto).to.not.include(\"passwordHash\");",
              "  pm.expect(texto).to.not.include(pm.environment.get(\"password\"));",
              "});",
              "pm.environment.set(\"token\", cuerpo.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario Postman\",\n  \"nombreFinca\": \"Finca Postman\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
