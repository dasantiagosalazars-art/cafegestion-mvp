# Copie este archivo como .env y complete los valores. NO suba .env al repositorio.
# Conexión a PostgreSQL (Supabase, "Session pooler", puerto 5432)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/postgres"
# Secreto para firmar los tokens JWT (cadena larga y aleatoria)
JWT_SECRET="cambie-este-valor"
# Duración del token (opcional)
JWT_EXPIRES_IN="1d"
# Origen permitido para CORS (opcional)
FRONTEND_URL="http://localhost:3000"
# Puerto del backend (opcional)
PORT=4000
